<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature android:name="android.hardware.wifi"
        android:required="false" />

    <application
        tools:replace="android:icon"
        android:name="karaoketvplayer.SmileKaraokeTvApp"
        android:icon="@mipmap/karaoke_tv_app_icon"
        android:banner="@mipmap/karaoke_tv_app_icon"
        android:label="@string/karaoke_tv_app_name"
        android:roundIcon="@mipmap/karaoke_tv_app_icon">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8354869049759576~5466555802" />           

        <activity
            android:name="karaoketvplayer.PhPlayerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="karaoketvplayer.TvPlayerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="karaokeplayer.ExoPlayerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false">
        </activity>
        <activity
            android:name="videoplayer.VlcPlayerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false">
        </activity>
        <activity android:name=".BaseActivity" />
        <activity android:name=".BaseFavoriteListActivity" />
        <activity android:name=".BaseSongDataActivity" />

        <service
            android:name=".services.BasePlayService"
            android:exported="false" />
        <service
            android:name="karaokeplayer.services.ExoPlayService"
            android:exported="false" />
        <service
            android:name="videoplayer.services.VlcPlayService"
            android:exported="false" />

    </application>

</manifest>
