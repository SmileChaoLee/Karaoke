<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparentMediumDark"
    android:gravity="center">

    <FrameLayout
        android:id="@+id/volumeButtonFrameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center">
        <ImageButton
            android:id="@+id/nonVolumeImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/non_volume"
            android:visibility="visible"
            android:layout_gravity="center"
            android:background="@drawable/main_menuitem_background_color">
        </ImageButton>
        <ImageButton
            android:id="@+id/volumeImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/volume"
            android:visibility="gone"
            android:layout_gravity="center"
            android:background="@drawable/main_menuitem_background_color">
        </ImageButton>
    </FrameLayout>
    <ImageButton
        android:id="@+id/previousMediaImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="0dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/previous_media_button_image"
        android:background="@drawable/main_menuitem_background_color">
    </ImageButton>
    <FrameLayout
        android:id="@+id/playPauseButtonFrameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center">
        <ImageButton
            android:id="@+id/playMediaImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/play_media_button_image"
            android:visibility="visible"
            android:layout_gravity="center"
            android:background="@drawable/main_menuitem_background_color">
        </ImageButton>
        <ImageButton
            android:id="@+id/pauseMediaImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/pause_media_button_image"
            android:visibility="gone"
            android:layout_gravity="center"
            android:background="@drawable/main_menuitem_background_color">
        </ImageButton>
    </FrameLayout>
    <ImageButton
        android:id="@+id/replayMediaImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="0dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/replay_media_button_image"
        android:background="@drawable/main_menuitem_background_color">
    </ImageButton>
    <ImageButton
        android:id="@+id/stopMediaImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="0dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/stop_media_button_image"
        android:background="@drawable/main_menuitem_background_color">
    </ImageButton>
    <ImageButton
        android:id="@+id/nextMediaImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="0dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/next_media_button_image"
        android:background="@drawable/main_menuitem_background_color">
    </ImageButton>
    <ImageButton
        android:id="@+id/heartImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="0dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/heart"
        android:background="@drawable/main_menuitem_background_color">
    </ImageButton>
    <ImageButton
        android:id="@+id/actionMenuImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:padding="0dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/circle_and_three_dots"
        android:background="@drawable/main_menuitem_background_color">
    </ImageButton>

</LinearLayout>