<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparentDarkGray">

    <TextView
        android:id="@+id/songsListMenuTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:textStyle="bold"
        android:textColor="@color/darkOrange"
        android:text="@string/songsListString"
        android:gravity="center"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toTopOf="parent">
    </TextView>
    <EditText
        android:id="@+id/songSearchEditText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:autofillHints=""
        android:inputType="textMultiLine"
        android:textColor="@color/my_editbox_textcolor"
        android:textCursorDrawable="@drawable/my_custom_cursor"
        android:background="@drawable/u2bkk_editbox_background"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusLeft="@id/songSearchEditText"
        android:nextFocusRight="@id/songSearchEditText"
        android:nextFocusDown="@id/songListRecyclerView"
        android:text=""
        android:hint="@string/songNameString"
        android:gravity="center"
        tools:ignore="LabelFor"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toBottomOf="@id/songsListMenuTextView">
    </EditText>
    <FrameLayout
        android:id="@+id/songsListView_Layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/yellow3"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintTop_toBottomOf="@id/songSearchEditText">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/songListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/yellow3"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability ="afterDescendants">
        </androidx.recyclerview.widget.RecyclerView>
        <TextView android:id="@+id/songListEmptyTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textStyle="bold"
            android:textColor="@color/blue"
            android:gravity="center"
            android:visibility="gone" >
        </TextView>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toBottomOf="@id/songsListView_Layout">
        <include layout="@layout/page_buttons_layout" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/exitShowVideoLayout"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toBottomOf="@id/buttonsLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:weightSum="5">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <include layout="@layout/exit_show_video_layout" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/songUnselectButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/emptyString"
            android:background="@drawable/main_menu_item_background_color"
            app:tint="@color/blue"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/unselect"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/nextPageButton"
            android:nextFocusLeft="@id/u2bKShowVideoButton"
            android:nextFocusRight="@id/songPlaySelectedButton"
            android:nextFocusDown="@id/songUnselectButton"
            android:layout_gravity="center"
            android:layout_weight="1">
        </ImageButton>
        <ImageButton
            android:id="@+id/songPlaySelectedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/emptyString"
            android:background="@drawable/main_menu_item_background_color"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/play_media_button_image"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/nextPageButton"
            android:nextFocusLeft="@id/songUnselectButton"
            android:nextFocusRight="@id/songAddToFavButton"
            android:nextFocusDown="@id/songPlaySelectedButton"
            android:layout_gravity="center"
            android:layout_weight="1">
        </ImageButton>
        <ImageButton
            android:id="@+id/songAddToFavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/emptyString"
            android:background="@drawable/main_menu_item_background_color"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:src="@drawable/add_image"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/nextPageButton"
            android:nextFocusLeft="@id/songPlaySelectedButton"
            android:nextFocusRight="@id/songAddToFavButton"
            android:nextFocusDown="@id/songAddToFavButton"
            android:layout_gravity="center"
            android:layout_weight="1">
        </ImageButton>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>